# syntax=docker/dockerfile:1

# --- Build stage ---
FROM node:22-alpine AS build

ARG APP_VERSION=dev
ARG GIT_SHA=unknown

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./frontend/
RUN cd frontend && npm ci --ignore-scripts

COPY VERSION ./
COPY frontend/ ./frontend/
RUN cd frontend && npm run postinstall && npm run build

# --- Serve stage ---
FROM nginxinc/nginx-unprivileged:1.27-alpine

ARG APP_VERSION=dev
ARG GIT_SHA=unknown

LABEL org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}"

COPY --from=build /app/frontend/dist /usr/share/nginx/html
# A template: the image's entrypoint writes it to /etc/nginx/conf.d/default.conf
# with CORE_UPSTREAM substituted (only that variable, see the filter).
COPY frontend/nginx.conf /etc/nginx/templates/default.conf.template
ENV CORE_UPSTREAM=core:8080 \
    NGINX_ENVSUBST_FILTER=^CORE_UPSTREAM$

EXPOSE 8080

# FIX-112: Verify nginx is serving content.
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -q --spider http://localhost:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
