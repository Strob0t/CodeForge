# syntax=docker/dockerfile:1

FROM python:3.12-slim AS build

ARG APP_VERSION=dev
ARG GIT_SHA=unknown

RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential git && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml poetry.lock ./

RUN pip install --no-cache-dir poetry && \
    poetry config virtualenvs.in-project true && \
    poetry install --only main --no-root --no-interaction --no-ansi

COPY VERSION ./
COPY workers/ workers/

RUN poetry install --only main --no-interaction --no-ansi

# --- Runtime stage ---
FROM python:3.12-slim

ARG APP_VERSION=dev
ARG GIT_SHA=unknown

LABEL org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}"

# acl: setfacl/getfacl for operators and scripts/check-host.sh (the worker
# itself sets ACLs through xattrs, codeforge.posix_acl). Tool processes run
# the system interpreter, never the worker's venv (a venv interpreter cannot
# run under Landlock): the Python tools they need (workers/tool-requirements.txt:
# pytest and ruff for the default quality gates of Python projects and the
# auto-agent's workspace test) go into it, pinned with hashes to poetry.lock.
# The stock image has no .pyc files and the read-only root keeps Python from
# writing them: the launch helper of every tool process
# (codeforge/tool_exec.py, run with -I -S) imports ctypes and json, about
# 80 ms per launch uncompiled, 24 ms compiled.
RUN --mount=type=bind,source=workers/tool-requirements.txt,target=/tmp/tool-requirements.txt \
    apt-get update && \
    apt-get install -y --no-install-recommends git acl && \
    rm -rf /var/lib/apt/lists/* && \
    python -m pip install --no-cache-dir --root-user-action=ignore --disable-pip-version-check \
        --require-hashes --only-binary=:all: -r /tmp/tool-requirements.txt && \
    python -m compileall -q /usr/local/lib/python3.12

# Users (KI-71, KI-96 / ADR-018): the worker runs as codeforge (10001, the
# core image's UID) in codeforge-ws (10010), which owns the shared workspaces
# volume at /data/workspaces with the Go Core. Every agent tool process runs
# as its tenant's tool user, 20000-29999 (codeforge-t<uid>), with no
# supplementary group; tenantless checks run as codeforge-system (19999).
# Their passwd and group lines are written directly: useradd would give each
# 65,536 subordinate IDs (it runs out near the 9,156th user) and costs about
# 14 ms per user. Without an entry git commit, id -un, node's os.userInfo()
# and ssh fail. 10002, the shared tool user of KI-71, is retired
# (codeforge-tool-legacy): it still owns files from before the upgrade and
# runs only the owner steps of their migration, outside the workspace group.
#
# The workspace root is 2771: tools can pass through it, not list it (tenant
# IDs) or create anything in it; tenant directories get POSIX ACLs for their
# tool UID (the Go Core's workspace.tool_acls: required). /home/codeforge-tools
# (0711) holds the tools' HOMEs on the tool_homes volume, created here so a
# fresh volume gets this owner and mode. The canary is world-readable; the
# isolation check fails when a tool process can read it (Landlock).
# Tool processes run git in repositories another UID created (safe.directory;
# the Go Core sets its own per repository, KI-77) and commit with a default
# identity (global and repository config win).
RUN groupadd -r -g 10010 codeforge-ws && \
    groupadd -r -g 10001 codeforge && useradd -r -u 10001 -g codeforge -G codeforge-ws codeforge && \
    groupadd -r -g 10002 codeforge-tool-legacy && \
    useradd -r -u 10002 -g codeforge-tool-legacy -d /nonexistent -M -s /usr/sbin/nologin codeforge-tool-legacy && \
    printf 'codeforge-system:x:19999:19999:CodeForge system tool user:/home/codeforge-tools/19999:/usr/sbin/nologin\n' \
        >> /etc/passwd && \
    printf 'codeforge-system:x:19999:\n' >> /etc/group && \
    seq 20000 29999 | awk '{ printf "codeforge-t%d:x:%d:%d:CodeForge tenant tool user:/home/codeforge-tools/%d:/usr/sbin/nologin\n", $1, $1, $1, $1 }' \
        >> /etc/passwd && \
    seq 20000 29999 | awk '{ printf "codeforge-t%d:x:%d:\n", $1, $1 }' >> /etc/group && \
    mkdir -p /data/workspaces && chown codeforge:codeforge /data && \
    chown codeforge:codeforge-ws /data/workspaces && chmod 2771 /data/workspaces && \
    install -d -o 10001 -g 10001 -m 0711 /home/codeforge-tools && \
    install -d -m 0755 /var/lib/codeforge && \
    printf 'tool processes must not read this file (Landlock canary, KI-96)\n' > /var/lib/codeforge/landlock-canary && \
    chmod 0644 /var/lib/codeforge/landlock-canary && \
    git config --system safe.directory '*' && \
    git config --system user.name 'CodeForge agent' && \
    git config --system user.email agent@codeforge.invalid

WORKDIR /app

COPY --from=build /app/.venv /app/.venv
COPY --from=build /app/workers /app/workers
COPY --from=build /app/VERSION /app/VERSION
COPY --from=build /app/pyproject.toml /app/pyproject.toml
COPY scripts/worker-healthcheck.py /app/scripts/worker-healthcheck.py
COPY --chmod=0755 scripts/worker-entrypoint.sh /app/scripts/worker-entrypoint.sh

# The worker's own PATH. Tool processes never get it (a venv interpreter
# cannot run under Landlock): they get CODEFORGE_TOOL_PATH.
ENV PATH="/app/.venv/bin:$PATH"

# deepeval (evaluation metrics) must not send telemetry or results to third
# parties (KI-54). codeforge.evaluation forces the same settings before it
# imports deepeval; the image covers deepeval started any other way.
ENV DEEPEVAL_TELEMETRY_OPT_OUT=YES \
    DEEPEVAL_UPDATE_WARNING_OPT_IN=0 \
    CONFIDENT_METRIC_LOGGING_ENABLED=NO \
    CONFIDENT_TRACING_ENABLED=NO \
    DEEPEVAL_DISABLE_DOTENV=1 \
    DEEPEVAL_DISABLE_LEGACY_KEYFILE=1

# Agent tool processes run as their tenant's tool user under Landlock
# (codeforge.tool_process; CODEFORGE_TOOL_LANDLOCK follows the isolation
# mode); a tool call fails when they cannot, and /health/ready answers 503.
# The container starts as root (no USER): the entrypoint runs the worker as
# codeforge with only CAP_SETUID, CAP_SETGID and CAP_KILL
# (docker-compose.prod.yml drops every other capability).
ENV CODEFORGE_TOOL_ISOLATION=required \
    CODEFORGE_WORKSPACE_GID=10010

# The worker serves GET /health (liveness) and GET /health/ready (connected to
# NATS, every consumer loop running, tool isolation ready) on
# CODEFORGE_WORKER_HEALTH_PORT (8081); the check asks /health/ready.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD python /app/scripts/worker-healthcheck.py || exit 1

ENTRYPOINT ["/app/scripts/worker-entrypoint.sh"]
CMD ["python", "-m", "codeforge.consumer"]
