# -- Worktrees ------------------------------------
.worktrees/

# -- Session memory -------------------------------
.remember/

# -- Secrets (production, generated) ---------------
# Any secrets/ directory (SECRETS_DIR may live elsewhere), except the Go package.
secrets/
!/internal/secrets/

# -- Dependencies ---------------------------------
.venv/
node_modules/
vendor/

# -- Build artifacts ------------------------------
/codeforge
/nats
dist/
build/
bin/
*.exe
*.dll
*.so
*.dylib

# -- Python ---------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# -- Go -------------------------------------------
# go.sum is committed for reproducible builds

# -- Frontend ------------------------------------
# node_modules/ and dist/ covered above
e2e-results/
e2e-results-llm/
e2e-report/
test-results/
**/e2e/.auth/

# -- IDE ------------------------------------------
.idea/
*.swp
*.swo
*~

# -- OS -------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# -- Environment ----------------------------------
.env
.env.*
!.env.example

# -- Config (secrets) ------------------------------
codeforge.yaml

# -- Persistent data (docker volumes, caches) ------
data/

# -- Backups ----------------------------------------
backups/

# -- Claude Code ----------------------------------
# Keep local state (worktrees, settings.local.json, ...) out; share the web
# session hook and its registration.
.claude/*
!.claude/settings.json
!.claude/hooks/
.superpowers/

# -- Serena MCP server (.mcp.json) -----------------
# Keep the shared project config; ignore caches, logs, memories and
# project.local.yml.
.serena/*
!.serena/project.yml
!.serena/claude-code-context.yml

# -- DeepEval (runtime telemetry) ------------------
.deepeval/

# -- Debug logs -----------------------------------
debug.log
*.log
__debug_bin*

# Dev tools (not part of the project)
/tools/

# -- Test artifacts (agent test run outputs) ------
tmp/
